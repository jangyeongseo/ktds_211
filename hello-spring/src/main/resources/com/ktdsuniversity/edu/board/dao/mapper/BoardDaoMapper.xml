<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ktdsuniversity.edu.board.dao.BoardDao">
	<!-- 전제 조회 -->
	<select id="selectBoardList"
		resultType="com.ktdsuniversity.edu.board.vo.BoardVO">
		SELECT
		ID,
		SUBJECT,
		CONTENT,
		EMAIL,
		VIEW_CNT,
		TO_CHAR(CRT_DT, 'YYYY-MM-DD HH24:MI:SS') AS CRT_DT,
		TO_CHAR(MDFY_DT, 'YYYY-MM-DD HH24:MI:SS') AS MDFY_DT,
		FILE_NAME,
		ORIGIN_FILE_NAME
		FROM BOARD
	</select>

	<!-- 개수 조회 -->
	<select id="selectBoardCount" resultType="_int">
		SELECT COUNT(ID)
		FROM
		BOARD
	</select>
	
	<!-- #: 파라미터 바인딩? -->
	<insert id="insertNewBoard" parameterType="com.ktdsuniversity.edu.board.vo.request.WriteVO">
	<!-- 새롭게 만들어지는 게시글의 pk를 미리 생성해서 WriteVO의 id라는 변수에 할당한다. -->
	<!--  
	order="BEFORE" : 시작되기 전에 selectKey가 먼저 실행하라는 의미 / 
	resultType="string" keyProperty="id" : String id에 값을 전달하겠다 라는 의미
	 -->
	<selectKey order="BEFORE" resultType="string" keyProperty="id">
	   SELECT 'BO-' || TO_CHAR(SYSDATE, 'YYYYMMDD-') || LPAD(SEQ_BOARD_PK.NEXTVAL, 6, '0')
	   FROM DUAL
	</selectKey>
	    INSERT INTO BOARD
	      (ID, SUBJECT, CONTENT, EMAIL, VIEW_CNT, CRT_DT, MDFY_DT, FILE_NAME, ORIGIN_FILE_NAME)
	    VALUES
	      ( #{id},
	        #{subject},
	        #{content},
	        #{email},
	        0,
	        SYSDATE,
	        SYSDATE,
	        null,
	        null
	      )
	</insert>
	
	<!-- 
	   Join 을 사용하는 쿼리의 결과를
	   Has a 를 사용하는 VO에게 값을 할당하기 윈한 태그
	 -->
	 <!-- autoMapping="true" : 이것이 있을 경우 result는 필요가 없다. -->
	<resultMap type="com.ktdsuniversity.edu.board.vo.BoardVO" id="BoardVOMap" autoMapping="true" >
	   <!-- 쿼리에 사용되는 테이블의 pk 값을 변수에 저장될 때 사용된다. column="ID" => B.ID /  property="id" => VO의 id -->
	   <id column="ID" property="id" />
	   
	   <!-- 쿼리에 사용되는 테이블의 일반 컬럼의 값을 변수에 저장될 때 사용된다. -->
	   <!-- <result column="SUBJECT" property="subject"/>
	   <result column="CONTENT" property="content"/>
	   <result column="EMAIL" property="email"/>
	   <result column="VIEW_CNT" property="viewCnt"/>
	   <result column="CRT_DT" property="crtDt"/>
	   <result column="MDFY_DT" property="mdfyDt"/>
	   <result column="FILE_NAME" property="fileName"/>
	   <result column="ORIGIN_FILE_NAME" property="originFileName"/> -->
	   
	   <!-- BoardVo 에 있는 List 는 <collection> 태그 이용 autoMapping="true" : 이것이 있어야먄 자동으로 일반 컬럼 값을 가져와 준다 -->
	   <collection property="files" javaType="list" ofType="com.ktdsuniversity.edu.files.vo.FilesVO" autoMapping="true" >
	       <id column="FILE_NUM" property="fileNum" />
	       <id column="FILE_GROUP_ID" property="fileGroupId" />
	       
	       <!-- <result column="OBFUSCATE_NAME" property="obfuscateName" />
	       <result column="DISPLAY_NAME" property="displayName" />
	       <result column="EXTEND_NAME" property="extendName" />
	       <result column="FILE_LENGTH" property="fileLength" />
	       <result column="FILE_PATH" property="filePath" /> -->
	   </collection>
	</resultMap>
	
	<!-- 게시글 조회 -->
	<!-- #{_parameter} : 이렇게 작성해야 나중에 문제가 생기지 않는다. _단일값 이라고 읽는다? -->
	<!-- resultMap="BoardVOMap" : join이 있을 때 작성 및 map을 이용해서 값을 가져온다 -->
    <select id="selectBoardById" resultMap="BoardVOMap" parameterType="string">
		SELECT
		    B.ID,
		    B.SUBJECT,
		    B.CONTENT,
		    B.EMAIL,
		    B.VIEW_CNT,
		    TO_CHAR(B.CRT_DT, 'YYYY-MM-DD HH24:MI:SS') AS CRT_DT,
		    TO_CHAR(B.MDFY_DT, 'YYYY-MM-DD HH24:MI:SS') AS MDFY_DT,
		    B.FILE_NAME,
		    B.ORIGIN_FILE_NAME,
		    F.FILE_NUM,
		    F.FILE_GROUP_ID,
		    F.OBFUSCATE_NAME,
		    F.DISPLAY_NAME,
		    F.EXTEND_NAME,
		    F.FILE_LENGTH,
		    F.FILE_PATH
		FROM
		    BOARD B
		LEFT OUTER JOIN FILES F
		ON
		    B.ID = F.FILE_GROUP_ID
		WHERE
		    B.ID = #{_parameter}
    </select>
    
    <update id="updateViewCntIncreaseById" parameterType="string">
        UPDATE BOARD
		SET VIEW_CNT= VIEW_CNT + 1
		WHERE ID = #{_parameter}
    </update>
    
    <!-- 수정 -->
    <update id="updateViewById" parameterType="com.ktdsuniversity.edu.board.vo.request.UpdateVO">
        UPDATE
		    BOARD
		SET
		    SUBJECT = #{subject},
		    CONTENT = #{content},
		    EMAIL =  #{email},
		    MDFY_DT = SYSDATE
		WHERE
		    ID = #{id}
    </update>
    
    
    <!-- 삭제 -->
    <delete id="deleteViewById" parameterType="string">
    DELETE FROM BOARD
	WHERE ID= #{_parameter}
    </delete>


</mapper>